<Window x:Class="ScreenFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenFrame"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Left="100"
        Top="100"
        Width="800"
        Height="600">
    
    <Grid>
        <Border Name="MainBorder"
                BorderBrush="Red" 
                BorderThickness="3"
                Background="Transparent">
            <Grid Background="Transparent"/>
        </Border>
        
        <!-- リサイズハンドル（設定モード時のみ表示） -->
        <Canvas Name="ResizeHandles" Visibility="Collapsed">
            <!-- 四隅のハンドル -->
            <Rectangle Name="TopLeftHandle" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                      Canvas.Left="-5" Canvas.Top="-5" Cursor="SizeNWSE"/>
            <Rectangle Name="TopRightHandle" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                      Canvas.Right="-5" Canvas.Top="-5" Cursor="SizeNESW"/>
            <Rectangle Name="BottomLeftHandle" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                      Canvas.Left="-5" Canvas.Bottom="-5" Cursor="SizeNESW"/>
            <Rectangle Name="BottomRightHandle" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                      Canvas.Right="-5" Canvas.Bottom="-5" Cursor="SizeNWSE"/>
            
            <!-- 辺のハンドル -->
            <Rectangle Name="TopHandle" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                      Canvas.Top="-5" Cursor="SizeNS"/>
            <Rectangle Name="BottomHandle" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                      Canvas.Bottom="-5" Cursor="SizeNS"/>
            <Rectangle Name="LeftHandle" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                      Canvas.Left="-5" Cursor="SizeWE"/>
            <Rectangle Name="RightHandle" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                      Canvas.Right="-5" Cursor="SizeWE"/>
        </Canvas>
        
        <!-- 設定モード表示 -->
        <TextBlock Name="SettingsModeText" 
                   Text="設定モード - ドラッグで移動、端でリサイズ、右クリックで設定、ESCで終了" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top" 
                   Margin="0,10,0,0"
                   Padding="10,5"
                   Background="#88000000"
                   Foreground="White"
                   FontSize="12"
                   Visibility="Collapsed"/>
    </Grid>
</Window>